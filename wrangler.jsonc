{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pgbrothers",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "r2_buckets": [
    {
      "binding": "PGBROTHERS_BUCKET",
      "bucket_name": "pgbrothers-db"
    }
  ],
  "observability": {
    "enabled": true
  }
}